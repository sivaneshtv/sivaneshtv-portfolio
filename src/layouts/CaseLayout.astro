---
import BaseLayout from './BaseLayout.astro';
import FreeRoamHint from '../components/canvas/FreeRoamHint.astro';

interface Props {
  title: string;
  caseNum: string;
  caseName: string;
  backHref?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, caseNum, caseName, backHref = '/#work', description, ogImage, jsonLd } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <div class="board-bg"></div>

  <div class="canvas-wrap" id="canvasWrap">
    <div class="canvas" id="canvas" style="width:5000px;height:6800px">
      <slot name="reader" />
      <slot name="artifacts" />
    </div>
  </div>

  <!-- Case topbar — same structure as workbench, case title instead of "the workbench" -->
  <div class="topbar">
    <div class="tb-logo-wrap">
      <a href={backHref} class="tb-logo" title="Back to workbench">
        <span class="back-ic"><svg viewBox="0 0 14 14" width="12" height="12"><path d="M9 3L4 7l5 4" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <span>Sivanesh.tv</span>
        <span class="tb-logo-sub">— {caseName}</span>
      </a>
    </div>
    <a href="/#contact" class="tb-contact">Contact ↗</a>
  </div>

  <!-- Toolbar (same as workbench) -->
  <div class="toolbar">
    <button class="tb-btn" id="btnZoomOut" title="Zoom out (−)">−</button>
    <div class="tb-zoom" id="zoomVal">100%</div>
    <button class="tb-btn" id="btnZoomIn" title="Zoom in (+)">+</button>
    <div class="tb-divider"></div>
    <button class="tb-btn" id="themeToggle" title="Toggle theme"><svg viewBox="0 0 16 16" width="12" height="12"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor"/></svg></button>
    <button class="tb-btn" id="btnFit" title="Fit (F)"><svg viewBox="0 0 16 16" width="12" height="12"><path d="M2 5V2h3 M11 2h3v3 M14 11v3h-3 M5 14H2v-3" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linecap="round"/></svg></button>
    <button class="tb-btn" id="btnLock" title="Free roam (L)" aria-pressed="false" aria-label="Unlock free roam">
      <svg class="ic-locked" viewBox="0 0 16 16" width="12" height="12"><rect x="3.5" y="7" width="9" height="7" rx="1" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
      <svg class="ic-unlocked" viewBox="0 0 16 16" width="12" height="12"><rect x="2.5" y="7" width="9" height="7" rx="1" stroke="currentColor" stroke-width="1.2" fill="none"/><path d="M8.5 7V5a2.5 2.5 0 0 1 5 0v1" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>
    </button>
  </div>

  <!-- Minimap -->
  <div class="minimap" id="minimap" title="Click to jump">
    <div class="minimap-label">Board</div>
    <div class="minimap-canvas" id="minimapCanvas"></div>
    <div class="minimap-viewport" id="minimapViewport"></div>
  </div>


  <!-- Free-roam hint -->
  <FreeRoamHint />

  <!-- The single way back. Same words whether the page drove the camera away
       (margin-ref jump) or the visitor unlocked the board themselves, and it stays
       for exactly as long as they are away from the reading. -->
  <div class="back-pill" id="backPill">
    <button class="back-pill-btn" id="backPillBtn">← Back to reading</button>
  </div>
</BaseLayout>

<style is:global>
  /* §6.1 — Topbar */
  .topbar{position:fixed;top:0;left:0;right:0;z-index:30;display:flex;justify-content:space-between;align-items:center;padding:20px 28px;pointer-events:none;-webkit-transform:translateZ(0);transform:translateZ(0);will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden}
  .topbar > *{pointer-events:auto}
  .tb-logo-wrap{position:relative}
  .tb-logo{display:flex;align-items:center;gap:10px;font-family:var(--fs);font-weight:600;font-size:14px;color:var(--ink);background:#e8e4db;padding:8px 12px 8px 10px;border:1px solid rgba(40,35,25,.12);box-shadow:0 4px 14px rgba(40,35,25,.08);cursor:pointer;transition:background .2s,border-color .2s;text-decoration:none}
  @media(hover:hover){.tb-logo:hover{background:rgba(232,228,219,1);border-color:rgba(40,35,25,.25)}}
  .tb-logo:active{background:rgba(220,216,207,1);border-color:rgba(40,35,25,.35)}
  .tb-logo-sub{color:var(--ink-3);font-weight:400;font-size:12px}
  .back-ic{display:inline-flex;align-items:center;justify-content:center;width:14px;color:var(--ink-2);transition:transform .2s,color .2s}
  @media(hover:hover){.tb-logo:hover .back-ic{transform:translateX(-2px);color:var(--red)}}
  .tb-logo:active .back-ic{transform:translateX(-2px);color:var(--red)}
  .tb-contact{
    display:flex;align-items:center;
    font-family:var(--fm);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
    color:#fff;background:var(--red);
    border:1px solid #b82b22;
    padding:8px 12px;text-decoration:none;
    box-shadow:0 4px 14px rgba(40,35,25,.08);
    height:39px;box-sizing:border-box;
    transition:background .2s,border-color .2s;
  }
  @media(hover:hover){.tb-contact:hover{background:#b82b22;border-color:#b82b22}}
  .tb-contact:active{background:#b82b22;border-color:#b82b22}
  .toolbar{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateZ(0);-webkit-transform:translateX(-50%) translateZ(0);z-index:30;display:flex;align-items:center;gap:2px;background:#e8e4db;border:1px solid rgba(40,35,25,.12);padding:6px;box-shadow:0 8px 30px rgba(40,35,25,.15),0 2px 6px rgba(40,35,25,.08);will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden}
  .tb-divider{width:1px;height:22px;background:rgba(40,35,25,.15);margin:0 4px;flex-shrink:0}
  .tb-btn{display:flex;align-items:center;justify-content:center;width:36px;height:36px;font-family:var(--fm);font-size:13px;color:var(--ink-2);border-radius:2px;transition:background .15s,color .15s}
  @media(hover:hover){.tb-btn:hover{background:rgba(40,35,25,.08);color:var(--ink)}}
  .tb-btn:active{background:rgba(40,35,25,.14);color:var(--ink)}
  .tb-btn.active{color:var(--marker-red)!important;background:rgba(216,53,42,.18)!important;transition:none!important}
  /* Padlock swaps closed -> open when free roam is unlocked (.active === unlocked) */
  #btnLock .ic-unlocked,#btnLock.active .ic-locked{display:none}
  #btnLock.active .ic-unlocked{display:block}
  [data-theme="dark"] .tb-btn.active{color:var(--marker-red)!important;background:rgba(232,74,63,.22)!important}
  .tb-btn svg{display:block}
  .tb-zoom{font-family:var(--fm);font-size:11px;letter-spacing:.08em;color:var(--ink-2);padding:0 12px;min-width:58px;text-align:center}
  .minimap{position:fixed;bottom:20px;right:20px;z-index:30;width:160px;height:112px;background:#e8e4db;border:1px solid rgba(40,35,25,.15);box-shadow:0 4px 16px rgba(40,35,25,.12);overflow:hidden;cursor:pointer;contain:layout style;-webkit-transform:translateZ(0);transform:translateZ(0);will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden}
  .minimap-canvas{position:absolute;inset:4px;background:transparent}
  .minimap-dot{position:absolute;background:var(--ink);border-radius:1px;opacity:.55}
  .minimap-dot.work{background:var(--marker-red);opacity:.75}
  .minimap-viewport{position:absolute;left:0;top:0;border:1.5px solid var(--marker-red);background:rgba(216,53,42,.08);pointer-events:none;transition:none}
  .minimap-label{position:absolute;top:4px;left:8px;font-family:var(--fm);font-size:8px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-3);pointer-events:none}
  @media(max-width:820px){
    .topbar{padding:14px 16px;flex-wrap:wrap;gap:10px}
    .tb-logo{padding:6px 10px;font-size:12px}
    .tb-logo-sub{display:none}
    .tb-contact{font-size:9px;height:32px;padding:0 10px}
    .toolbar{bottom:12px;left:50%;-webkit-transform:translateX(-50%) translateZ(0);transform:translateX(-50%) translateZ(0);padding:4px;gap:1px}
    .tb-btn{width:32px;height:32px}
    .tb-zoom{padding:0 6px;min-width:46px;font-size:10px}
    .tb-divider{height:18px;margin:0 2px}
    .minimap{display:none}
  }
  @media(prefers-reduced-motion:reduce){
    *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
  }

  /* Back-to-reading pill */
  .back-pill{
    position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(8px);z-index:40;
    will-change:transform;backface-visibility:hidden;-webkit-backface-visibility:hidden;
    display:flex;align-items:center;gap:8px;
    background:rgba(26,26,28,.94);color:#f5ede0;
    padding:8px;
    font-family:var(--fm);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
    white-space:nowrap;
    box-shadow:0 8px 24px rgba(40,35,25,.3);
    opacity:0;pointer-events:none;visibility:hidden;
    transition:opacity .3s ease,transform .3s ease,visibility 0s linear .3s;
  }
  .back-pill.on{
    opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0);
    visibility:visible;transition-delay:0s;
  }
  .back-pill-btn:focus-visible{outline:2px solid #f5ede0;outline-offset:2px}
  .back-pill-btn{
    font-family:var(--fm);font-size:10px;letter-spacing:.14em;text-transform:uppercase;
    color:#fff;background:var(--red);border:none;padding:7px 12px;cursor:pointer;transition:background .2s;
  }
  @media(hover:hover){.back-pill-btn:hover{background:#b82b22}}
  .back-pill-btn:active{background:#b82b22}
  @media(max-width:640px){
    .back-pill{bottom:72px;padding:6px;font-size:9px}
    /* This pill is the primary exit on touch — keep it a comfortable 44px target */
    .back-pill-btn{
      display:flex;align-items:center;justify-content:center;
      min-height:44px;padding:0 20px;font-size:9px;
    }
  }
</style>

<script>
  import { CanvasEngine } from '../components/canvas/engine/CanvasEngine';

  const engine = new CanvasEngine({
    canvasEl: document.getElementById('canvas')!,
    canvasWrap: document.getElementById('canvasWrap')!,
    minimap: document.getElementById('minimap')!,
    minimapCanvas: document.getElementById('minimapCanvas')!,
    minimapViewport: document.getElementById('minimapViewport')!,
    zoomLabel: document.getElementById('zoomVal')!,
    zones: {
      top:      { cx: 2500, cy: 1000, scale: 0.55 },
      problem:  { cx: 2500, cy: 2300, scale: 0.55 },
      solution: { cx: 2500, cy: 4200, scale: 0.55 },
      outcome:  { cx: 2500, cy: 6200, scale: 0.55 },
    },
    zoneBounds: {
      top:      { x1: 1000, y1: 500,  x2: 4000, y2: 1800 },
      problem:  { x1: 1000, y1: 1800, x2: 4000, y2: 3300 },
      solution: { x1: 1000, y1: 3300, x2: 4000, y2: 5600 },
      outcome:  { x1: 1000, y1: 5600, x2: 4000, y2: 6800 },
    },
    canvasWidth: 5000,
    canvasHeight: 6800,
    mode: 'case',
    onViewStateChange: (state) => syncViewUI(state),
  });

  // Case pages boot in the reading state — the reader viewport is the page
  const lockBtn = document.getElementById('btnLock');
  const backPill = document.getElementById('backPill');
  /** The margin-ref that started the current detour, so focus can go home. */
  let jumpOrigin: HTMLElement | null = null;

  // One place decides every affordance, so they can never disagree:
  //   padlock — is the board unlocked? Only the visitor's own action flips it, so an
  //             aside leaves it alone: the page moved the camera, they did not.
  //   pill    — am I away from the reading? Shown in both aside and roam, identical
  //             wording, no timeout. It is the exit, and an exit never expires.
  function syncViewUI(state: 'reading' | 'aside' | 'roam') {
    const unlocked = state === 'roam';
    lockBtn?.classList.toggle('active', unlocked);
    lockBtn?.setAttribute('aria-pressed', String(unlocked));
    lockBtn?.setAttribute('aria-label', unlocked ? 'Back to reading' : 'Unlock free roam');
    backPill?.classList.toggle('on', state !== 'reading');
    if (state === 'reading') restoreFocusAfterReturn();
  }

  // Focus follows the camera. The jump moved it to the way back; returning gives it
  // to the link that started the detour, so Tab resumes where the visitor left off.
  // Driven by the state change, so it holds for every exit — pill, padlock, Esc, R —
  // and not just the one the pill happens to call.
  function restoreFocusAfterReturn() {
    const origin = jumpOrigin;
    jumpOrigin = null;
    if (!origin) return;
    // Only reclaim focus if it is still ours to move: on the pill we are hiding, or
    // dropped to <body> because that pill vanished underneath it.
    const active = document.activeElement;
    const ours = !active || active === document.body || backPill?.contains(active);
    if (!ours) return;
    requestAnimationFrame(() => origin.focus({ preventScroll: true }));
  }
  syncViewUI('reading');

  (window as any).__canvasEngine = engine;

  document.getElementById('btnZoomIn')?.addEventListener('click', () => engine.zoomIn());
  document.getElementById('btnZoomOut')?.addEventListener('click', () => engine.zoomOut());
  document.getElementById('btnFit')?.addEventListener('click', () => engine.fit());
  lockBtn?.addEventListener('click', () => engine.toggleFreeRoam());
  document.getElementById('backPillBtn')?.addEventListener('click', () => engine.backToReading());

  // Margin-ref activation → jumpToArtifact (MARGIN-REF-SPEC.md §4).
  // These are <a> elements with no href, so they carry role="button" + tabindex="0"
  // and need Enter/Space wired by hand — a plain anchor gets that for free, a
  // scripted one does not.
  document.querySelectorAll<HTMLElement>('.r-margin-ref[data-jump]').forEach(link => {
    const activate = (e: Event) => {
      e.preventDefault();
      const slug = link.dataset.jump;
      if (!slug) return;
      jumpOrigin = link;
      engine.jumpToArtifact(slug);
      // The page just moved the camera away from what the visitor was reading.
      // Move focus with it, onto the way back, so a keyboard user is not left
      // tabbing through a document they can no longer see.
      requestAnimationFrame(() => document.getElementById('backPillBtn')?.focus());
    };

    link.addEventListener('click', activate);
    link.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') activate(e);
    });
  });

  // Free-roam hint — anchored above the lock button, centered on mobile
  (() => {
    const roamHint = document.querySelector<HTMLElement>('.roam-hint');
    const btn = document.getElementById('btnLock');
    if (!roamHint || !btn) return;

    const anchorHint = () => {
      const r = btn.getBoundingClientRect();
      const hintW = roamHint.getBoundingClientRect().width || roamHint.offsetWidth || 220;
      const margin = 8;
      // Ideal: center the hint over the button
      const idealLeft = r.left + r.width / 2;
      // Clamp so the hint never clips the screen edge
      const clampedLeft = Math.max(hintW / 2 + margin, Math.min(window.innerWidth - hintW / 2 - margin, idealLeft));
      roamHint.style.left = clampedLeft + 'px';
      roamHint.style.bottom = (window.innerHeight - r.top + 10) + 'px';
      // If clamping shifted the hint, move the arrow to still point at the button
      const arrowShift = idealLeft - clampedLeft; // px the hint moved left
      const arrowPct = 50 + (arrowShift / hintW) * 100;
      roamHint.style.setProperty('--arrow-x', Math.max(8, Math.min(92, arrowPct)) + '%');
    };
    anchorHint();

    let dismissed = false;
    const dismiss = () => { if (dismissed) return; dismissed = true; roamHint.classList.remove('on'); };
    setTimeout(() => { anchorHint(); roamHint.classList.add('on'); }, 800);
    setTimeout(dismiss, 9000);
    const once = { once: true } as const;
    document.getElementById('canvasWrap')?.addEventListener('pointerdown', dismiss, once);
    btn.addEventListener('click', dismiss, once);
  })();

  // Theme toggle
  document.getElementById('themeToggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const next = isDark ? '' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('sivanesh.theme', next);
  });
</script>
